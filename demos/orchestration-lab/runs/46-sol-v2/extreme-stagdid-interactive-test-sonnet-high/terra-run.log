/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-413-                      nstates = 40) {
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-414-  
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-415-  # unit fixed effects (unobserved heterogeneity)
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-416-  unit <- tibble(
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-417-    unit = 1:nobs,
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-418-    # generate state
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-419-    state = sample(1:nstates, nobs, replace = TRUE),
--
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-441-  # full interaction of unit X year 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-442-  expand_grid(unit = 1:nobs, year = 1980:2010) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-443-    left_join(., unit) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-444-    left_join(., year) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-445-    left_join(., treat_taus) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-446-    # make error term and get treatment indicators and treatment effects
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-447-    # Also get cohort specific trends (modify time FE)
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-448-    mutate(error = rnorm(nobs*31, 0, 1),
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd:449:           treat = ifelse((year >= cohort_year)* (cohort_year != 2004), 1, 0),
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd:450:           tau = ifelse(treat == 1, mu, 0),
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-451-           year_fe = year_fe + 0.1*(year - cohort_year)
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-452-    ) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-453-    # calculate cumulative treatment effects
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-454-    group_by(unit) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-455-    mutate(tau_cum = cumsum(tau)) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-456-    ungroup() %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-457-    # calculate the dep variable
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-458-    mutate(dep_var = (2010 - cohort_year) + unit_fe + year_fe + tau_cum + error) %>%
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd:459:    # Relabel 2004 cohort as never-treated
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-460-    mutate(cohort_year = ifelse(cohort_year == 2004, Inf, cohort_year))
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-461-  
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-462-}
