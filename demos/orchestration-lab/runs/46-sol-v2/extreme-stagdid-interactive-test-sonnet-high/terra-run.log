/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd:818:## Generate data - treated cohorts consist of 250 obs each, with the treatment effect still = true_mu on average
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-819-make_data3 <- function(nobs = 1000, 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-820-                      nstates = 40) {
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-821-  
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-822-  # unit fixed effects (unobserved heterogeneity)
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-823-  unit <- tibble(
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-824-    unit = 1:nobs,
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-825-    # generate state
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-826-    state = sample(1:nstates, nobs, replace = TRUE),
--
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-848-  # full interaction of unit X year 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-849-  expand_grid(unit = 1:nobs, year = 1980:2010) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-850-    left_join(., unit) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-851-    left_join(., year) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-852-    left_join(., treat_taus) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-853-    # make error term and get treatment indicators and treatment effects
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-854-    # Also get cohort specific trends (modify time FE)
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-855-    mutate(error = rnorm(nobs*31, 0, 1),
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd:856:           treat = ifelse((year >= cohort_year)* (cohort_year != 2004), 1, 0),
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-857-           mu = ifelse(cohort_year==1992, 2, ifelse(cohort_year==1998, 1, 3)),
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd:858:           tau = ifelse(treat == 1, mu, 0),
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-859-           year_fe = year_fe + 0.1*(year - cohort_year)
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-860-    ) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-861-    # calculate cumulative treatment effects
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-862-    group_by(unit) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-863-    mutate(tau_cum = cumsum(tau)) %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-864-    ungroup() %>% 
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-865-    # calculate the dep variable
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-866-    mutate(dep_var = (2010 - cohort_year) + unit_fe + year_fe + tau_cum + error) %>%
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd:867:    # Relabel 2004 cohort as never-treated
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-868-    mutate(cohort_year = ifelse(cohort_year == 2004, Inf, cohort_year))
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-869-  
/opt/homebrew/lib/R/4.5/site-library/did/doc/TWFE.Rmd-870-}
