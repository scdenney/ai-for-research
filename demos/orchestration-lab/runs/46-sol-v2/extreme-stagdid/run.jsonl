     0.0211         -0.0076      0.0752  \\n  2007 2005   0.0311     0.0179         -0.0040      0.0661  \\n  2007 2006   0.0000         NA              NA          NA  \\n  2007 2007  -0.0261     0.0167         -0.0587      0.0066  \\n---\\nSignif. codes: `*' confidence band does not cover 0\\n\\nP-value for pre-test of parallel trends assumption:  0.16812\\nControl Group:  Never Treated,  Anticipation Periods:  0\\nEstimation Method:  Doubly Robust\\nNULL\\nsummary names:\\nNULL\\n NULL\\ndyn inf.function:\\nList of 2\\n $ dynamic.inf.func.e: num [1:500, 1:7] 3.86e-18 3.86e-18 3.86e-18 3.86e-18 3.86e-18 ...\\n $ dynamic.inf.func  : num [1:500] -1.8823 2.358 -0.0787 -6.1957 -2.1008 ...\\nDIDparams names:\\n [1] \\\"yname\\\"                        \\\"tname\\\"                       \\n [3] \\\"idname\\\"                       \\\"gname\\\"                       \\n [5] \\\"xformla\\\"                      \\\"panel\\\"                       \\n [7] \\\"est_method\\\"                   \\\"bstrap\\\"                      \\n [9] \\\"biters\\\"                       \\\"cband\\\"                       \\n[11] \\\"anticipation\\\"                 \\\"control_group\\\"               \\n[13] \\\"allow_unbalanced_panel\\\"       \\\"weightsname\\\"                 \\n[15] \\\"base_period\\\"                  \\\"clustervars\\\"                 \\n[17] \\\"cores\\\"                        \\\"pl\\\"                          \\n[19] \\\"print_details\\\"                \\\"faster_mode\\\"                 \\n[21] \\\"alp\\\"                          \\\"true_repeated_cross_sections\\\"\\n[23] \\\"time_periods_count\\\"           \\\"time_periods\\\"                \\n[25] \\\"treated_groups_count\\\"         \\\"treated_groups\\\"              \\n[27] \\\"id_count\\\"                     \\\"outcomes_tensor\\\"             \\n[29] \\\"data\\\"                         \\\"time_invariant_data\\\"         \\n[31] \\\"cohort_counts\\\"                \\\"period_counts\\\"               \\n[33] \\\"crosstable_counts\\\"            \\\"covariates_tensor\\\"           \\n[35] \\\"covariates_matrix\\\"            \\\"cluster_vector\\\"              \\n[37] \\\"weights_vector\\\"               \\\"weights_tensor\\\"              \\n[39] \\\"fix_weights\\\"                  \\\"call\\\"                        \\n[41] \\\"extra_args\\\"                   \\\"compute_inffunc\\\"             \\nList of 42\\n $ yname                       : chr \\\"lemp\\\"\\n $ tname                       : chr \\\"year\\\"\\n $ idname                      : chr \\\"countyreal\\\"\\n $ gname                       : chr \\\"first.treat\\\"\\n $ xformla                     :Class 'formula'  language ~1\\n  .. ..- attr(*, \\\".Environment\\\")=<environment: R_GlobalEnv> \\n $ panel                       : logi TRUE\\n $ est_method                  : chr \\\"dr\\\"\\n $ bstrap                      : logi FALSE\\n $ biters                      : num 1000\\n $ cband                       : logi FALSE\\n $ anticipation                : num 0\\n $ control_group               : chr \\\"nevertreated\\\"\\n $ allow_unbalanced_panel      : logi FALSE\\n $ weightsname                 : NULL\\n $ base_period                 : chr \\\"universal\\\"\\n $ clustervars                 : chr \\\"countyreal\\\"\\n $ cores                       : num 1\\n $ pl                          : logi FALSE\\n $ print_details               : logi FALSE\\n $ faster_mode                 : logi TRUE\\n $ alp                         : num 0.05\\n $ true_repeated_cross_sections: logi FALSE\\n $ time_periods_count          : int 5\\n $ time_periods                : int [1:5] 2003 2004 2005 2006 2007\\n $ treated_groups_count        : int 3\\n $ treated_groups              : num [1:3] 2004 2006 2007\\n $ id_count                    : int 500\\n $ outcomes_tensor             :List of 5\\n  ..$ : num [1:500] 5.19 5.43 5.09 4.93 4.36 ...\\n  ..$ : num [1:500] 5.07 5.42 5 4.6 4.39 ...\\n  ..$ : num [1:500