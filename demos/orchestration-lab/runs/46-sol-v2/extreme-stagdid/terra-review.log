/opt/homebrew/lib/R/4.5/site-library/did/doc/did-basics.Rmd-204-                                   idname = "id",
/opt/homebrew/lib/R/4.5/site-library/did/doc/did-basics.Rmd-205-                                   gname = "G",
/opt/homebrew/lib/R/4.5/site-library/did/doc/did-basics.Rmd-206-                                   xformla = ~X,
/opt/homebrew/lib/R/4.5/site-library/did/doc/did-basics.Rmd-207-                                   data = dta,
/opt/homebrew/lib/R/4.5/site-library/did/doc/did-basics.Rmd:208:                                   control_group = "notyettreated"			
/opt/homebrew/lib/R/4.5/site-library/did/doc/did-basics.Rmd-209-                                   )
/opt/homebrew/lib/R/4.5/site-library/did/doc/did-basics.Rmd-210-summary(example_attgt_altcontrol)
/opt/homebrew/lib/R/4.5/site-library/did/doc/did-basics.Rmd-211-```
