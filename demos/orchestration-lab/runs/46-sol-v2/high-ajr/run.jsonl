{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nsuppressPackageStartupMessages({library(ivdoctr); library(AER)})\ndata(colonial, package='ivdoctr')\ncat('dim', dim(colonial), '\\\\n')\ncat('codes neo', paste(colonial\"'$shortnam[colonial$shortnam %in% c('\"'AUS','CAN','NZL','USA')], collapse=','), '\\\\n')\ncat('rich4 codes', paste(colonial\"'$shortnam[colonial$rich4 == 1], collapse='\"','), '\\\\n')\nprint(colSums(is.na(colonial[c('logpgp95','avexpr','logem4','lat_abst','africa','asia','shortnam','rich4')])))\nrun <- function(label, controls=character(), keep=rep(TRUE,nrow(colonial))){\n d <- colonial[keep, , drop=FALSE]\n vars <- c('logpgp95','avexpr','logem4',controls)\n d <- d[complete.cases(d[,vars,drop=FALSE]),,drop=FALSE]\n rhs <- paste(c('avexpr',controls), collapse=' + ')\n zr <- paste(c('logem4',controls), collapse=' + ')\n ols <- lm(as.formula(paste('logpgp95 ~', rhs)), data=d)\n iv <- AER::ivreg(as.formula(paste('logpgp95 ~',rhs,'|',zr)), data=d)\n fsu <- lm(as.formula(paste('avexpr ~',zr)), data=d)\n fsr <- lm(as.formula(paste('avexpr ~', if(length(controls)) paste(controls,collapse=' + ') else '1')), data=d)\n at <- anova(fsr,fsu)\n sm <- summary(iv, diagnostics=TRUE)\n cat('\\\\n',label,' n=',nrow(d),' OLS=',coef(ols)['avexpr'],' IV=',coef(iv)['avexpr'],' fsb=',coef(fsu)['logem4'],' F=',at\"'$F[2], '\"'\\\\n', sep='')\n print(sm\"'$diagnostics)\n}\nrun('\"'Baseline')\nrun('Latitude', 'lat_abst')\nrun('Continents', c('africa','asia'))\nrun('Drop neo', keep=\"'!colonial$shortnam %in% c('\"'AUS','CAN','NZL','USA'))\nrun('Africa only', keep=colonial\"'$africa==1)\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
