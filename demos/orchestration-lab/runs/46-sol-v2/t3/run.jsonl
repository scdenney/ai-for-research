ent Error**\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/correct.Rmd-36-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/correct.Rmd-37-- **Estimates the intra-respondent reliability (IRR)** based on responses to a repeated task\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/correct.Rmd:38:- **Adjusts marginal means (MMs) and average marginal component effects (AMCEs)** accordingly\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/correct.Rmd-39-- **Provides corrected estimates** that better reflect respondents’ true preferences\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/correct.Rmd-40-- Corrected estimates reveal the true magnitude of effects, **improving both theoretical and applied inferences** in political science, marketing, and other fields.\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/correct.Rmd-41-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/correct.Rmd-42-✅ No additional respondent burden (just one repeated task)  \n--\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-38-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-39-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-40-## ----error=TRUE---------------------------------------------------------------\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-41-try({\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:42:outcomes <- paste0(\"choice\", 1:8)\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:43:outcomes1 <- c(outcomes, \"choice1_repeated_flipped\")\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-44-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:45:out1 <- reshape_projoint(\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-46-  .dataframe = exampleData1,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-47-  .outcomes = outcomes1,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:48:  .choice_labels = c(\"A\", \"B\"),\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-49-  .alphabet = \"K\",\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-50-  .idvar = \"ResponseId\",\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-51-  .repeated = TRUE,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-52-  .flipped = TRUE\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-53-)\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-54-})\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-55-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-56-## -----------------------------------------------------------------------------\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:57:outcomes <- paste0(\"choice\", 1:8)\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:58:outcomes2 <- c(outcomes, \"choice1_repeated_notflipped\")\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:59:out2 <- reshape_projoint(\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-60-  .dataframe = exampleData2,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-61-  .outcomes = outcomes2,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-62-  .repeated = TRUE,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-63-  .flipped = FALSE\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-64-)\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-65-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-66-## -----------------------------------------------------------------------------\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:67:outcomes <- paste0(\"choice\", 1:8)\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:68:out3 <- reshape_projoint(\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-69-  .dataframe = exampleData3,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-70-  .outcomes = outcomes,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-71-  .repeated = FALSE\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-72-)\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-73-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-74-## -----------------------------------------------------------------------------\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:75:fill_FALSE <- reshape_projoint(\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-76-  .dataframe = exampleData1,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-77-  .outcomes = outcomes1,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-78-  .fill = FALSE\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-79-)\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-80-\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R:81:fill_TRUE <- reshape_projoint(\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-82-  .dataframe = exampleData1,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-83-  .outcomes = outcomes1,\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-84-  .fill = TRUE\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/read.R-85-)\n--\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/analyze.Rmd-1----\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/analyze.Rmd-2-title: \"Analyze and Visualize Important QOIs\"\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/analyze.Rmd-3-output: rmarkdown::html_vignette\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/analyze.Rmd-4-description: >\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/analyze.Rmd:5:  How to estimate and correct marginal means (MMs) or average marginal component effects (AMCEs), including predicting IRR if necessary. Visualize these and other QOIs of interest.\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/analyze.Rmd-6-vignette: >\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/analyze.Rmd-7-  %\\VignetteIndexEntry{Analyze and Visualize Important QOIs}\n/opt/homebrew/lib/R/4.5/site-library/projoint/doc/analyze.Rmd-8-  %\\VignetteEngine{kn