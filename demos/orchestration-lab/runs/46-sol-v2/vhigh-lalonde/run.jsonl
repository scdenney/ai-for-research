0001464 0.0003158 0.0005634 0.0093092 0.0022766 0.3982966 \n\n$`1`\n     Min.   1st Qu.    Median      Mean   3rd Qu.      Max. \n0.0002879 0.0771110 0.1438365 0.1952870 0.3341921 0.3836557 \n\nsupport 0.0002879385 0.3836557 kept 12706 185 dropped 3286 \n\n earnings \n$`0`\n     Min.   1st Qu.    Median      Mean   3rd Qu.      Max. \n3.770e-06 1.293e-05 1.421e-04 8.438e-03 1.847e-03 4.884e-01 \n\n$`1`\n     Min.   1st Qu.    Median      Mean   3rd Qu.      Max. \n0.0007016 0.1304294 0.2568346 0.2705936 0.4550153 0.4874457 \n\nsupport 0.0007016468 0.4874457 kept 5776 185 dropped 10216 \n\npackages\nMatchIt TRUE 4.7.2 \nsandwich TRUE 3.1.1 \nlmtest TRUE 0.9.40 \nclubSandwich FALSE  \nggplot2 TRUE 4.0.2 \ndplyr TRUE 1.2.0 \n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nlibrary(causaldata)\nnsw <- causaldata::nsw_mixtape; cps <- causaldata::cps_mixtape\nobs <- rbind(transform(nsw[nsw\"'$treat==1,], unit_id=paste0('\"'T', data_id)), transform(cps, unit_id=paste0('C', data_id)))\nobs\"'$row_id <- seq_len(nrow(obs))\nforms <- list(Demographics=treat ~ age + educ + black + hisp + marr + nodegree,\n              `Demographics + earnings`=treat ~ age + educ + black + hisp + marr + nodegree + re74 + re75)\ncluster_se <- function(d,g){ m<-length(d); G<-length(unique(g)); e<-d-mean(d); U<-tapply(e,g,sum); sqrt(G/(G-1)*sum(U''^2)/m''^2)}\nfor(nm in names(forms)) for(trim in c(FALSE,TRUE)) {\n d<-obs; p0<-fitted(glm(forms[[nm]],d,family=binomial()))\n if(trim){lo<-max(tapply(p0,d$treat,min));hi<-min(tapply(p0,d$treat,max)); d<-d[p0>=lo&p0<=hi,]}\n d$ps<-fitted(glm(forms[[nm]],d,family=binomial()))\n tr<-d[d$treat==1,]; co<-d[d$treat==0,]\n ord<-order(co$ps); sp<-co$ps[ord]; pos<-findInterval(tr$ps,sp); poslo<-pmax(1,pos); poshi<-pmin(length(sp),pos+1); dlo<-abs(tr$ps-sp[poslo]); dhi<-abs(tr$ps-sp[poshi]); idxo<-ifelse(dlo<=dhi,poslo,poshi); mi<-ord[idxo]; dif<-tr$re78-co$re78[mi]\n est<-mean(dif); se<-cluster_se(dif, co$unit_id[mi]); G<-length(unique(co$unit_id[mi])); crit<-qt(.975,G-1)\n cat('\"'\\\\n',nm,'trim',trim,'n',nrow(tr),nrow(co),'NN',est,'se',se,'G',G,'CI',est+c(-1,1)*crit*se,'maxreuse',max(table(co\"'$unit_id[mi])),'\"'\\\\n')\n qs<-unique(as.numeric(quantile(tr\"'$ps, probs=seq(.2,.8,.2), names=FALSE, type=7)))\n d$stratum<-cut(d$ps, breaks=c(-Inf,qs,Inf), labels=FALSE, include.lowest=TRUE)\n ss<-split(d,d$stratum); att<-0; vv<-0\n for(z in ss){ nt<-sum(z$treat==1); nc<-sum(z$treat==0); w<-nt/nrow(tr); dt<-z$re78[z$treat==1]; dc<-z$re78[z$treat==0]; att<-att+w*(mean(dt)-mean(dc)); vv<-vv+w''^2*(var(dt)/nt+var(dc)/nc); cat('\"' s',unique(z\"'$stratum),'\"'nt',nt,'nc',nc,'diff',mean(dt)-mean(dc),'\\\\n')}\n cat('strat',att,'se',sqrt(vv),'CI',att+c(-1,1)*qnorm(.975)*sqrt(vv),'\\\\n')\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
