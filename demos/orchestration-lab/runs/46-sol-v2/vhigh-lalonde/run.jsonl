{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nset.seed(20260719)\nlibrary(causaldata);library(MatchIt)\nobs<-rbind(subset(causaldata::nsw_mixtape,treat==1),causaldata::cps_mixtape);obs\"'$source_id<-sprintf('\"'U%05d',seq_len(nrow(obs)))\nforms<-list(Demographics=treat~age+educ+black+hisp+marr+nodegree,\"'`Demographics + earnings`=treat~age+educ+black+hisp+marr+nodegree+re74+re75)\nfor(nm in names(forms))for(trim in c(FALSE,TRUE)){\n  m<-matchit(forms[[nm]],data=obs,method='\"'nearest',distance='glm',estimand='ATT',replace=TRUE,ratio=1,discard=if(trim)'both' else 'none',reestimate=trim)\n  gm<-get_matches(m,data=obs,id='matching_id')\n  wide<-reshape(gm[c('subclass','treat','re78','source_id')],idvar='subclass',timevar='treat',direction='wide')\n  diff<-wide\"'$re78.1-wide$re78.0; g<-wide$source_id.0;m0<-length(diff);G<-length(unique(g));u<-tapply(diff-mean(diff),g,sum);se<-sqrt(G/(G-1)*sum(u''^2)/m0''^2)\n  cat(nm,trim,mean(diff),se,G,max(table(g)),'\"'n',sum(m\"'$weights[obs$treat==1]>0),sum(m$weights[obs$treat==0]>0),'\"'\\\\n')\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
