{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nlibrary(causaldata)\nnsw <- causaldata::nsw_mixtape\ncps <- causaldata::cps_mixtape\ncat('R', R.version.string, '\\\\n')\ncat('nsw', nrow(nsw), 'cps', nrow(cps), '\\\\n')\nprint(names(nsw))\nprint(table(nsw\"'$treat)); print(table(cps$treat))\nbench <- with(nsw, mean(re78[treat==1]) - mean(re78[treat==0]))\nnaive <- mean(nsw$re78[nsw$treat==1]) - mean(cps$re78)\ncat('\"'benchmark', bench, 'naive', naive, '\\\\n')\ncat('means', mean(nsw\"'$re78[nsw$treat==1]), mean(nsw$re78[nsw$treat==0]), mean(cps$re78), '\"'\\\\n')\nobs <- rbind(transform(nsw[nsw\"'$treat==1,], source='\"'NSW treated'), transform(cps, source='CPS control'))\nforms <- list(demo=treat ~ age + educ + black + hisp + marr + nodegree,\n              earnings=treat ~ age + educ + black + hisp + marr + nodegree + re74 + re75)\nfor(nm in names(forms)) {\n  m <- glm(forms[[nm]], data=obs, family=binomial())\n  p <- fitted(m)\n  cat('\\\\n',nm,'\\\\n')\n  print(tapply(p, obs\"'$treat, summary))\n  lo <- max(min(p[obs$treat==1]), min(p[obs$treat==0])); hi <- min(max(p[obs$treat==1]), max(p[obs$treat==0]))\n  keep <- p >= lo & p <= hi\n  cat('\"'support',lo,hi,'kept',table(obs\"'$treat[keep]),'\"'dropped',table(obs\"'$treat[!keep]),'\"'\\\\n')\n}\ncat('\\\\npackages\\\\n')\nfor(p in c('MatchIt','sandwich','lmtest','clubSandwich','ggplot2','dplyr')) cat(p, requireNamespace(p,quietly=TRUE), if(requireNamespace(p,quietly=TRUE)) as.character(packageVersion(p)) else '', '\\\\n')\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
