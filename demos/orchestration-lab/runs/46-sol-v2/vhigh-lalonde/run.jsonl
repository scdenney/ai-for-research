{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nset.seed(20260719)\nlibrary(causaldata);library(MatchIt);library(sandwich)\nobs <- rbind(subset(causaldata::nsw_mixtape,treat==1), causaldata::cps_mixtape)\nobs\"'$source_id <- sprintf('\"'unit_%05d',seq_len(nrow(obs)))\nforms <- list(Demographics=treat~age+educ+black+hisp+marr+nodegree, \"'`Demographics + earnings`=treat~age+educ+black+hisp+marr+nodegree+re74+re75)\nfor(nm in names(forms)) for(trim in c(FALSE,TRUE)) {\n p <- fitted(glm(forms[[nm]],obs,family=binomial())); tr <- obs$treat==1\n lo <- max(min(p[tr]),min(p[!tr])); hi <- min(max(p[tr]),max(p[!tr])); keep <- if(trim) p>=lo&p<=hi else rep(TRUE,length(p)); d<-obs[keep,]; ps<-p[keep]\n m<-matchit(forms[[nm]],data=d,method='\"'nearest',distance=ps,estimand='ATT',replace=TRUE,ratio=1)\n md<-match_data(m,data=d); fit_hc<-lm(re78~treat,md,weights=weights); se_hc<-sqrt(vcovHC(fit_hc,type='HC3')['treat','treat'])\n gm<-get_matches(m,data=d,id='matchit_id'); fit_tw<-lm(re78~treat,gm,weights=weights); vtw<-vcovCL(fit_tw,cluster=list(gm\"'$subclass,gm$source_id),type='\"'HC1',cadjust=TRUE,multi0=TRUE);se_tw<-sqrt(vtw['treat','treat'])\n cat(nm,'trim',trim,'est',coef(fit_tw)['treat'],'HC3',se_hc,'2way',se_tw,'CI',coef(fit_tw)['treat']+c(-1,1)*qt(.975,min(length(unique(gm\"'$subclass)),length(unique(gm$source_id)))-1)*se_tw,'\"'pairs',length(unique(gm\"'$subclass)),'\"'units',length(unique(gm\"'$source_id)),'\"'\\\\n')\n}\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
