+}
+drive_max_lines <- unlist(lapply(drive_labels$level_id, function(baseline_id) {
+  z <- drive_amce[drive_amce$estimand == "amce_corrected" & drive_amce$baseline_id == baseline_id & drive_amce$estimate != 0, ]
+  sprintf("  %s baseline: %.1f pp", labels$level[match(baseline_id, labels$level_id)], 100 * max(abs(z$estimate)))
+}))
