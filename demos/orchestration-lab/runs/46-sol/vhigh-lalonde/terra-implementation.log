+  geom_point(size = 2.4) +
+  scale_colour_manual(values = c("Naive" = unname(oi["orange"]),
+                                 "Demographic covariates" = unname(oi["sky_blue"]),
+                                 "Earnings covariates" = unname(oi["bluish_green"])), name = NULL) +
+  labs(x = "Estimated ATT on 1978 earnings (dollars)",
