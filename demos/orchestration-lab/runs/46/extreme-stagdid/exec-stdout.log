+  rs_att$estimate[1], rs_att$se[1],
+  100 * w_treated_never, 100 * w_late_early, bad_avg,
+  100 * w_early_late, twfe_gap,
+  event_df$estimate[event_df$event_time == -3],
+  event_df$estimate[event_df$event_time == -2],
