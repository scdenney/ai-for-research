+estimates <- data.frame(
+  estimator = c(
+    "Naive TWFE",
+    "Callaway-Sant'Anna",
+    "Callaway-Sant'Anna",
+    "Sun-Abraham",
+    "Roth-Sant'Anna"
+  ),
+  att = c(
+    twfe_ct["post", "Estimate"],
+    cs_nyt$overall.att,
+    cs_never$overall.att,
+    sa_att["ATT", "Estimate"],
+    rs_att$estimate[1]
+  ),
