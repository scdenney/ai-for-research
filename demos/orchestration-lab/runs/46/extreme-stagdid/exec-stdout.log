+  nrow(d) == 2500L,
+  length(unique(d$countyreal)) == 500L,
+  all(table(d$countyreal) == 5L),
+  all(sort(unique(d$first.treat)) == c(0, 2004, 2006, 2007)),
+  all(is.infinite(d$g_staggered[d$first.treat == 0]))
+)
