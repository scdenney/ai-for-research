+    width = 0.12,
+    colour = okabe_ito[["blue"]],
+    linewidth = 0.7
+  ) +
+  geom_point(
+    colour = okabe_ito[["blue"]],
+    fill = "white",
+    shape = 21,
+    size = 2.7,
+    stroke = 0.8
+  ) +
