+  filename = file.path("figures", "event-study.png"),
+  plot = event_plot,
+  width = 7,
+  height = 4.5,
+  units = "in",
+  dpi = 320,
+  bg = "white"
+)
+
+# Collate every estimator requested (plus the Roth-Sant'Anna cross-check).
+estimates <- data.frame(
+  estimator = c(
+    "Naive TWFE",
+    "Callaway-Sant'Anna",
+    "Callaway-Sant'Anna",
+    "Sun-Abraham",
+    "Roth-Sant'Anna"
+  ),
