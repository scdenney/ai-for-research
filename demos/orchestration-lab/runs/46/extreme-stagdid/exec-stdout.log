set.seed(4601)
suppressPackageStartupMessages({library(did); library(fixest); library(bacondecomp); library(staggered)})
data(mpdta)
d <- mpdta
d"'$post <- as.integer(d$first.treat > 0 & d$year >= d$first.treat)
cat('"'N units rows', nrow(d), length(unique(d"'$countyreal)), '"'\\n')
# TWFE
m <- feols(lemp ~ post | countyreal + year, data=d, cluster=~countyreal)
print(coeftable(m))
# CS no cov analytical + bootstrap maybe
for (cg in c('notyettreated','nevertreated')) {
  cat('\\nCS',cg,'analytical\\n')
  o <- att_gt(yname='lemp', tname='year', idname='countyreal', gname='first.treat', xformla=~1, data=d, control_group=cg, clustervars='countyreal', bstrap=FALSE, cband=FALSE, print_details=FALSE)
  a <- aggte(o, type='simple', bstrap=FALSE, cband=FALSE)
  print(c(overall.att=a"'$overall.att, overall.se=a$overall.se, pretest.p=o$Wpval))
  dy <- aggte(o,type='"'dynamic',bstrap=FALSE,cband=FALSE,min_e=-3,max_e=3)
  print(data.frame(e=dy"'$egt,att=dy$att.egt,se=dy$se.egt)); print(c(overall=dy$overall.att,se=dy$overall.se))
}
# SunAB
sa <- feols(lemp ~ sunab(first.treat, year) | countyreal + year, data=d, cluster=~countyreal)
cat('"'\\nSA default summary model\\n'); print(summary(sa, agg='ATT', cluster=~countyreal)"'$coeftable)
cat('"'\\nSA aggregate\\n'); print(aggregate(sa, agg='ATT', vcov=~countyreal))
cat('\\nSA coef\\n'); print(coeftable(sa))
# bacon
cat('\\nBacon\\n')
b <- bacon(lemp ~ post, data=d, id_var='countyreal', time_var='year')
print(b)
print(aggregate(weight ~ type, b, sum)); print(aggregate(estimate ~ type, b, function(x)c(n=length(x), min=min(x),max=max(x))))
# staggered conventions and estimate if helpful
ds <- d; ds"'$g_stag <- ifelse(ds$first.treat==0, Inf, ds$first.treat)
cat('"'\\nstaggered simple\\n'); st <- staggered(df=ds, i='countyreal', t='year', g='g_stag', y='lemp', estimand='simple'); print(st)
