+# bootstrap critical value yields simultaneous 95% confidence intervals.
+dynamic <- aggte(
+  cs_nyt_gt,
+  type = "dynamic",
+  min_e = -3,
+  max_e = 3,
+  bstrap = TRUE,
+  cband = TRUE,
+  biters = 999
+)
