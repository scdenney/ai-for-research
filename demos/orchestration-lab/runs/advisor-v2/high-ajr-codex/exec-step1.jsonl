{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RSCRIPT'\nlibrary(ivdoctr)\nlibrary(AER)\nlibrary(car)\ndata(colonial, package = \\\"ivdoctr\\\")\nrun_spec <- function(name, controls = character(), filter = function(d) rep(TRUE, nrow(d))) {\n  vars <- c(\\\"logpgp95\\\", \\\"avexpr\\\", \\\"logem4\\\", controls)\n  d <- colonial[filter(colonial), vars, drop = FALSE]\n  d <- d[complete.cases(d), , drop = FALSE]\n  rhs <- paste(c(\\\"avexpr\\\", controls), collapse = \\\" + \\\")\n  inst <- paste(c(\\\"logem4\\\", controls), collapse = \\\" + \\\")\n  ols <- lm(reformulate(c(\\\"avexpr\\\", controls), \\\"logpgp95\\\"), data = d)\n  iv <- ivreg(as.formula(paste(\\\"logpgp95 ~\\\", rhs, \\\"|\\\", inst)), data = d)\n  fs <- lm(reformulate(c(\\\"logem4\\\", controls), \\\"avexpr\\\"), data = d)\n  excluded <- linearHypothesis(fs, \\\"logem4 = 0\\\", test = \\\"F\\\")\n  cat(\\\"\\\\n\\\", name, \\\"N\\\", nrow(d), \\\"\\\\n\\\", sep = \\\"\\\")\n  cat(\\\"OLS \\\", coef(ols)[\\\"avexpr\\\"], \\\" | IV \\\", coef(iv)[\\\"avexpr\\\"], \\\" | FS coef \\\", coef(fs)[\\\"logem4\\\"], \\\" | F \\\", excluded[2,\\\"F\\\"], \\\" df \\\", excluded[2,\\\"Df\\\"], \\\",\\\", excluded[2,\\\"Res.Df\\\"], \\\" p\\\", excluded[2,\\\"Pr(>F)\\\"], \\\"\\\\n\\\", sep=\\\"\\\")\n  print(coef(summary(ols))[\\\"avexpr\\\",])\n  print(coef(summary(iv))[\\\"avexpr\\\",])\n}\nrun_spec(\\\"Bivariate\\\")\nrun_spec(\\\"Latitude\\\", \\\"lat_abst\\\")\nrun_spec(\\\"Continent\\\", c(\\\"africa\\\", \\\"asia\\\"))\nrun_spec(\\\"Drop neo\\\", filter = function(d) \"'!d$shortnam %in% c(\"AUS\", \"CAN\", \"NZL\", \"USA\"))\nrun_spec(\"Africa\", filter = function(d) d$africa == 1)\nRSCRIPT'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
