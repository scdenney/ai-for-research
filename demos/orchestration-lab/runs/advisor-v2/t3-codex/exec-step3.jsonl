{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nsuppressPackageStartupMessages(library(projoint))\ndata(exampleData1, package='projoint')\nout <- reshape_projoint(exampleData1, .outcomes=c(paste0('choice',1:8),'choice1_repeated_flipped'))\nd <- as.data.frame(out\"'$data)\nlabels <- as.data.frame(out$labels)\nirr <- mean(unique(d[!is.na(d$agree),c('\"'id','agree')])\"'$agree)\ntau <- (1 - sqrt(1 - 2*(1-irr)))/2\ncat('\"'irr',irr,'tau',tau,'denom',1-2*tau,'\\\\n')\nfor (i in seq_len(nrow(labels))) {\n  at<-labels\"'$attribute_id[i]; lev<-sub('\"'.*:','',labels\"'$level_id[i])\n  raw<-mean(d$selected[as.character(d[[at]])==lev])\n  corr<-(raw-tau)/(1-2*tau)\n  cat(labels$attribute[i], labels$level[i], raw,corr,'\"'\\\\n')\n}\ncat('\\\\npackage\\\\n')\nfit<-projoint(out,.structure='profile_level',.estimand='mm',.se_method='analytical',.se_type_2='stata')\nprint(fit\"'$estimates[fit$estimates$estimand=='\"'mm_corrected',])\nRS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
