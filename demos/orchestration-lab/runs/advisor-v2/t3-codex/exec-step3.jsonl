{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nlibrary(projoint)\nx <- getAnywhere('organize_data'); print(x)\nRS\"","aggregated_output":"A single object matching ‘organize_data’ was found\nIt was found in the following places\n  namespace:projoint\nwith value\n\nfunction (.dataframe, .structure, .estimand, .remove_ties, .att_choose, \n    .lev_choose, .att_notchoose, .lev_notchoose) \n{\n    structure <- rlang::arg_match0(.structure, c(\"choice_level\", \n        \"profile_level\"))\n    if ((is.null(.remove_ties) | !is.logical(.remove_ties))) {\n        stop(\"The .remove_ties argument must be logical.\")\n    }\n    if (structure == \"profile_level\") {\n        if (is.null(.att_choose) | length(.att_choose) != 1) {\n            stop(\"The .att_choose argument must be a character with the length of 1.\")\n        }\n        if (is.null(.lev_choose) | length(.lev_choose) != 1) {\n            stop(\"The .lev_choose argument must be a character with the length of 1.\")\n        }\n        if (!is.null(.att_notchoose)) {\n            stop(\"The .att_notchoose argument must be null.\")\n        }\n        if (!is.null(.lev_notchoose)) {\n            stop(\"The .lev_notchoose argument must be null.\")\n        }\n    }\n    else if (structure == \"choice_level\") {\n        if (is.null(.att_choose) | length(.att_choose) != 1) {\n            stop(\"The .att_choose argument must be a character with the length of 1.\")\n        }\n        if (is.null(.lev_choose) | length(.lev_choose) < 1) {\n            stop(\"The .lev_choose argument must be a character with the length of 1+.\")\n        }\n        if (is.null(.att_notchoose) | length(.att_notchoose) != \n            1) {\n            stop(\"The .att_notchoose argument must be a character with the length of 1.\")\n        }\n        if (is.null(.lev_notchoose) | length(.lev_notchoose) < \n            1) {\n            stop(\"The .lev_notchoose argument must be a character with the length of 1+.\")\n        }\n    }\n    else {\n        stop(\"The .structure argument should be either profile_level or choice_level.\")\n    }\n    if (structure == \"profile_level\") {\n        attlev_choose <- stringr::str_c(.att_choose, \":\", .lev_choose)\n        att_choose <- rlang::sym(.att_choose)\n        out2 <- out1 <- dplyr::select(dplyr::filter(dplyr::mutate(.dataframe, \n            qoi_choose = !!att_choose), qoi_choose %in% attlev_choose), \n            -matches(\"^att\\\\d+$\"))\n        if (.remove_ties == TRUE) {\n            out2 <- dplyr::select(dplyr::filter(dplyr::ungroup(dplyr::mutate(dplyr::group_by(out1, \n                id, task), ties = dplyr::n() - 1)), ties == 0), \n                -ties)\n        }\n        out <- out2\n    }\n    else {\n        attlev_choose <- stringr::str_c(.att_choose, \":\", .lev_choose)\n        attlev_notchoose <- stringr::str_c(.att_notchoose, \":\", \n            .lev_notchoose)\n        keep_task_constant_cols <- function(df, id_cols) {\n            if (!all(c(\"id\", \"task\", \"profile\") %in% names(df))) {\n                return(id_cols)\n            }\n            core <- intersect(c(\"id\", \"task\", \"agree\"), id_cols)\n            cand <- setdiff(id_cols, core)\n            if (length(cand) == 0L) {\n                return(core)\n            }\n            max_ndist <- unlist(dplyr::summarise(dplyr::summarise(dplyr::group_by(df, \n                id, task), dplyr::across(dplyr::all_of(cand), \n                ~dplyr::n_distinct(.x, na.rm = FALSE)), .groups = \"drop\"), \n                dplyr::across(dplyr::everything(), ~max(.x, na.rm = TRUE))), \n                use.names = TRUE)\n            safe <- names(max_ndist)[max_ndist <= 1]\n            unique(c(core, safe))\n        }\n        if (.att_choose == .att_notchoose) {\n            out1 <- dplyr::select(dplyr::mutate(.dataframe, qoi = !!rlang::sym(.att_choose)), \n                -matches(\"^att\\\\d+$\"))\n            id_cols <- setdiff(names(out1), c(\"profile\", \"selected\", \n                \"selected_repeated\", \"qoi\"))\n            id_cols <- keep_task_constant_cols(out1, id_cols)\n            out2 <- tidyr::pivot_wider(out1, id_cols = dplyr::all_of(id_cols), \n                names_from = profile, values_from = c(selected, \n                  qoi))\n            stopifnot(all(dplyr::pull(dplyr::count(out2, id, \n                task), n) == 1L))\n            out3 <- dplyr::filter(out2, (qoi_1 %in% attlev_choose & \n                qoi_2 %in% attlev_notchoose) | (qoi_1 %in% attlev_notchoose & \n                qoi_2 %in% attlev_choose))\n        }\n        else {\n            out1 <- dplyr::select(dplyr::mutate(.dataframe, qoi_choose = !!rlang::sym(.att_choose), \n                qoi_notchoose = !!rlang::sym(.att_notchoose)), \n                -matches(\"^att\\\\d+$\"))\n            id_cols <- setdiff(names(out1), c(\"profile\", \"selected\", \n                \"selected_repeated\", \"qoi_choose\", \"qoi_notchoose\"))\n            id_cols <- keep_task_constant_cols(out1, id_cols)\n            out2 <- tidyr::pivot_wider(out1, id_cols = dplyr::all_of(id_cols), \n                names_from = profile, values_from = c(selected, \n                  qoi_choose, qoi_notchoose))\n            stopifnot(all(dplyr::pull(dplyr::count(out2, id, \n                task), n) == 1L))\n            out3 <- dplyr::filter(out2, (qoi_choose_1 %in% attlev_choose & \n                qoi_notchoose_2 %in% attlev_notchoose) | (qoi_choose_2 %in% \n                attlev_choose & qoi_notchoose_1 %in% attlev_notchoose))\n        }\n        out <- out3\n    }\n    data1 <- tibble::as_tibble(dplyr::select(dplyr::ungroup(dplyr::slice(dplyr::group_by(dplyr::filter(.dataframe, \n        !is.na(agree)), id), 1)), -matches(\"^att\\\\d+$\")))\n    data2 <- out\n    return(list(data_for_irr = data1, data_for_estimand = data2))\n}\n<bytecode: 0x82e06c4d8>\n<environment: namespace:projoint>\n","exit_code":0,"status":"completed"}}
