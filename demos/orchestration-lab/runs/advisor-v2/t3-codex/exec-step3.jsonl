{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nsuppressPackageStartupMessages(library(projoint))\ndata(exampleData1, package='projoint')\nout <- reshape_projoint(exampleData1, .outcomes=c(paste0('choice',1:8),'choice1_repeated_flipped'))\nd<-as.data.frame(out\"'$data); labels<-as.data.frame(out$labels)\nirr <- mean(unique(d[!is.na(d$agree),c('\"'id','agree')])\"'$agree); tau<-(1-sqrt(1-2*(1-irr)))/2\nmm_raw <- function(att,lev) {dd<-d[as.character(d[[att]])==lev,]; kk<-interaction(dd$id,dd$task,drop=TRUE); dd<-dd[ave(rep(1,nrow(dd)),kk,FUN=length)==1,]; mean(dd$selected)}\nfor(i in seq_len(nrow(labels))){raw<-mm_raw(labels$attribute_id[i],labels$level_id[i]);cat(sprintf('\"'%s %.9f %.9f\\\\n',labels\"'$level_id[i],raw,(raw-tau)/(1-2*tau)))}\nRS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
