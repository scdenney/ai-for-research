nd(\n   146\t  data.frame(\n   147\t    attribute_short = range_data$attribute_short,\n   148\t    value = range_data$min_mm, conf.low = range_data$min_low,\n   149\t    conf.high = range_data$min_high, is_crime = range_data$is_crime\n   150\t  ),\n   151\t  data.frame(\n   152\t    attribute_short = range_data$attribute_short,\n   153\t    value = range_data$max_mm, conf.low = range_data$max_low,\n   154\t    conf.high = range_data$max_high, is_crime = range_data$is_crime\n   155\t  )\n   156\t)\n   157\t\n   158\tfigure <- ggplot(range_data, aes(y = attribute_short)) +\n   159\t  geom_vline(xintercept = 0.5, linetype = \"dashed\", colour = \"#8C8C8C\") +\n   160\t  geom_segment(\n   161\t    aes(x = min_mm, xend = max_mm, yend = attribute_short),\n   162\t    colour = \"#777777\", linewidth = 1\n   163\t  ) +\n   164\t  geom_segment(\n   165\t    data = range_data[range_data$is_crime, ],\n   166\t    aes(x = min_mm, xend = max_mm, yend = attribute_short),\n   167\t    colour = \"#0072B2\", linewidth = 1.4\n   168\t  ) +\n   169\t  geom_errorbar(\n   170\t    data = endpoints,\n   171\t    aes(x = value, xmin = conf.low, xmax = conf.high),\n   172\t    orientation = \"y\", width = 0.12, colour = \"#333333\", linewidth = 0.55\n   173\t  ) +\n   174\t  geom_point(\n   175\t    data = endpoints,\n   176\t    aes(x = value, shape = is_crime, fill = is_crime),\n   177\t    size = 3.2, colour = \"#222222\", stroke = 0.4\n   178\t  ) +\n   179\t  scale_shape_manual(values = c(`FALSE` = 21, `TRUE` = 24), guide = \"none\") +\n   180\t  scale_fill_manual(values = c(`FALSE` = \"#FFFFFF\", `TRUE` = \"#0072B2\"), guide = \"none\") +\n   181\t  scale_x_continuous(\n   182\t    name = \"Marginal mean of profile selection (IRR-corrected probability)\",\n   183\t    limits = c(0.30, 0.70), breaks = seq(0.30, 0.70, 0.10)\n   184\t  ) +\n   185\t  scale_y_discrete(name = NULL) +\n   186\t  theme_minimal(base_size = 11) +\n   187\t  theme(\n   188\t    panel.grid.major.y = element_blank(),\n   189\t    panel.grid.minor = element_blank(),\n   190\t    axis.text.y = element_text(colour = \"#222222\"),\n   191\t    axis.title.x = element_text(margin = margin(t = 8)),\n   192\t    plot.margin = margin(8, 18, 8, 8)\n   193\t  )\n   194\t\n   195\tggsave(\n   196\t  filename = file.path(out_dir, \"sensitivity.png\"),\n   197\t  plot = figure, width = 8, height = 5, units = \"in\", dpi = 320,\n   198\t  bg = \"white\"\n   199\t)\n   200\t\n   201\t# --- Markdown sensitivity table -------------------------------------------\n   202\t\n   203\tmarkdown_table <- function(d) {\n   204\t  header <- paste0(\"| \", paste(names(d), collapse = \" | \"), \" |\")\n   205\t  rule <- paste0(\"|\", paste(rep(\"---\", ncol(d)), collapse = \"|\"), \"|\")\n   206\t  body <- apply(d, 1, function(row) paste0(\"| \", paste(row, collapse = \" | \"), \" |\"))\n   207\t  c(header, rule, body)\n   208\t}\n   209\t\n   210\tmm_display <- data.frame(\n   211\t  Attribute = mm$attribute,\n   212\t  Level = mm$level,\n   213\t  `Marginal mean [95% CI]` = sprintf(\n   214\t    \"%.3f [%.3f, %.3f]\", mm$estimate, mm$conf.low, mm$conf.high\n   215\t  ),\n   216\t  check.names = FALSE, stringsAsFactors = FALSE\n   217\t)\n   218\t\n   219\ttable_text <- c(\n   220\t  \"# Reference-category sensitivity and marginal means\",\n   221\t  \"\",\n   222\t  paste0(\n   223\t    \"All entries are IRR-corrected profile-level estimates from `projoint`; \",\n   224\t    \"95% confidence intervals are in brackets. The repeated task estimates tau = \",\n   225\t    sprintf(\"%.3f\", mm_fit$tau), \". Marginal means are baseline-invariant.\"\n   226\t  ),\n   227\t  \"\",\n   228\t  \"## Violent Crime Rate AMCEs under each baseline\",\n   229\t  \"\",\n   230\t  \"Each non-reference cell is the AMCE for the row level relative to the column's reference level.\",\n   231\t  \"\",\n   232\t  markdown_table(crime_rebaseline),\n   233\t  \"\",\n   234\t  \"The crime attribute is binary, so changing the reference merely reverses the sign of the one pairwise contrast; its absolute magnitude is unchanged.\",\n   235\t  \"\",\n   236\t  \"## Multi-level check: Housing Cost AMCEs under each baseline\",\n   237\t  \"\",\n   238\t  \"With three levels, the numerical AMCE attached to a level changes with the selected reference, although every pairwise contrast is the same comparison regardless of coding.\",\n   239\t  \"\",\n   240\t  markdown_table(housing_rebaseline),\n   241\t  \"\",\n   242\t  \"## Marginal means for all levels\",\n   243\t  \"\",\n   244\t  markdown_table(mm_display),\n   245\t  \"\",\n   246\t  \"Figure caption: Endpoint marginal means (with 95% confidence intervals) for each attribute. Lines span the minimum and maximum observed marginal mean within each attribute; blue triangles identify the two crime-rate levels. The figure uses 400 respondents and 8 paired tasks per respondent (plus one flipped repeat); MMs are IRR-corrected profile-selection probabilities.\"\n   247\t)\n   248\t\n   249\twriteLines(table_text, \"sensitivity-table.md\", useBytes = TRUE)\n   250\t\n   251\tmessage(\"Estimated IRR tau: \", sprintf(\"%.3f\", mm_fit$tau))\n   252\tmessage(\"Wrote figures/sensitivity.png and sensitivity-table.md\")\n","exit_code":0,"status":"completed"}}
