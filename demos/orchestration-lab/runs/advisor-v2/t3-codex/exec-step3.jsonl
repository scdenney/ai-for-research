{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"Rscript - <<'RS'\nsource(\\\"script.R\\\")\nfit <- projoint(\n  out, .structure = \\\"profile_level\\\", .estimand = \\\"mm\\\",\n  .se_method = \\\"analytical\\\", .clusters_1 = id, .se_type_1 = \\\"stata\\\",\n  .clusters_2 = id, .se_type_2 = \\\"stata\\\"\n)\nreference <- as.data.frame(fit\"'$estimates, stringsAsFactors = FALSE)\nreference <- reference[reference$estimand == \"mm_corrected\", ]\nreference <- reference[match(mm$level_id, reference$att_level_choose), ]\nmax_difference <- max(abs(mm$estimate - reference$estimate))\ncat(\"max point-estimate difference from projoint:\", format(max_difference, scientific = TRUE), \"'\"\\\\n\\\")\nstopifnot(max_difference < 1e-12)\nstopifnot(nrow(mm_boot) == 5000L, ncol(mm_boot) == 24L)\nstopifnot(all(range_difference_ci[1] < range_difference, range_difference < range_difference_ci[2]))\nRS\ngit diff --check -- memo.md script.R sensitivity-table.md figures/sensitivity.png\ngit diff --numstat -- memo.md script.R sensitivity-table.md figures/sensitivity.png\nfile figures/sensitivity.png\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
