--- script.R ---
#!/usr/bin/env Rscript

# Sensitivity analysis for AMCE reference categories in exampleData1.
# Run from this directory with: Rscript script.R

suppressPackageStartupMessages({
  library(projoint)
  library(ggplot2)
})

out_dir <- "figures"
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)

# --- Data and model ---------------------------------------------------------

data(exampleData1, package = "projoint")
out <- reshape_projoint(
  exampleData1,
  .outcomes = c(paste0("choice", 1:8), "choice1_repeated_flipped")
)

stopifnot(nrow(out$data) == 6400L, length(unique(out$data$id)) == 400L)
labels <- as.data.frame(out$labels, stringsAsFactors = FALSE)

# The profile-level estimand is the probability that a profile is selected.
# The repeated task permits projoint to estimate and correct for IRR.  We
# consistently report its corrected quantities.  MMs use CR2 respondent-
# clustered analytical standard errors (the package default); AMCEs use the
# package's stable clustered "stata" variance estimator, because CR2 is
# non-PSD for some single-contrast AMCE fits in this small repeated-task design.
mm_fit <- projoint(
  out,
  .structure = "profile_level",
  .estimand = "mm",
  .se_method = "analytical"
)

mm_raw <- as.data.frame(mm_fit$estimates, stringsAsFactors = FALSE)
mm_raw <- mm_raw[mm_raw$estimand == "mm_corrected", ]
mm <- cbind(
  labels,
  mm_raw[match(labels$level_id, mm_raw$att_level_choose),
         c("estimate", "se", "conf.low", "conf.high")]
)
row.names(mm) <- NULL

amce_contrast <- function(target_id, baseline_id) {
  if (identical(target_id, baseline_id)) {
    return(data.frame(
      estimate = 0, se = NA_real_, conf.low = NA_real_, conf.high = NA_real_,
      stringsAsFactors = FALSE
    ))
  }

  target_att <- sub(":.*$", "", target_id)
  baseline_att <- sub(":.*$", "", baseline_id)
  stopifnot(identical(target_att, baseline_att))

  qoi <- set_qoi(
    .structure = "profile_level",
    .estimand = "amce",
    .att_choose = target_att,
    .lev_choose = sub("^.*:", "", target_id),
    .att_choose_b = baseline_att,
    .lev_choose_b = sub("^.*:", "", baseline_id)
  )
  fit <- projoint(
    out,
    .qoi = qoi,
    .se_method = "analytical",
    .se_type_2 = "stata"
  )
  estimates <- as.data.frame(fit$estimates, stringsAsFactors = FALSE)
  estimates <- estimates[estimates$estimand == "amce_corrected",
                         c("estimate", "se", "conf.low", "conf.high")]
  stopifnot(nrow(estimates) == 1L)
  estimates
}

fmt_ci <- function(x) {
  if (is.na(x$se[1])) return("0.000 (reference)")
  sprintf("%.3f [%.3f, %.3f]", x$estimate[1], x$conf.low[1], x$conf.high[1])
}

attribute_ids <- function(attribute_name) {
  labels$level_id[labels$attribute == attribute_name]
}

make_rebaseline_table <- function(attribute_name) {
  ids <- attribute_ids(attribute_name)
  out_table <- data.frame(Level = labels$level[match(ids, labels$level_id)],
                          check.names = FALSE, stringsAsFactors = FALSE)
  for (baseline_id in ids) {
    baseline_label <- labels$level[match(baseline_id, labels$level_id)]
    column <- vapply(ids, function(target_id) {
      fmt_ci(amce_contrast(target_id, baseline_id))
    }, character(1))
    out_table[[baseline_label]] <- column
  }
  out_table
}

crime_attribute <- "Violent Crime Rate (Vs National Rate)"
housing_attribute <- "Housing Cost"
crime_rebaseline <- make_rebaseline_table(crime_attribute)
housing_rebaseline <- make_rebaseline_table(housing_attribute)

# --- Figure: baseline-invariant MM endpoint ranges ------------------------

# This plot deliberately shows only the empirical min/max MMs in each
# attribute.  It makes the visual comparison used in the memo while the full
# all-level MM results are retained in the table below.
range_rows <- lapply(split(mm, mm$attribute), function(d) {
  lo <- d[which.min(d$estimate), ]
  hi <- d[which.max(d$estimate), ]
  data.frame(
    attribute = lo$attribute[1],
    min_level = lo$level[1], min_mm = lo$estimate[1],
    min_low = lo$conf.low[1], min_high = lo$conf.high[1],
    max_level = hi$level[1], max_mm = hi$estimate[1],
    max_low = hi$conf.low[1], max_high = hi$conf.high[1],
    range = hi$estimate[1] - lo$estimate[1],
    stringsAsFactors = FALSE
  )
})
range_data <- do.call(rbind, range_rows)
range_data <- range_data[order(range_data$range), ]

short_attribute <- c(
  "Housing Cost" = "Housing cost",
  "Presidential Vote (2020)" = "Presidential vote (2020)",
  "Racial Composition" = "Racial composition",
  "School Quality" = "School quality",
  "Total Daily Driving Time for Commuting and Errands" = "Daily driving time",
  "Type of Place" = "Type of place",
  "Violent Crime Rate (Vs National Rate)" = "Violent crime rate"
)
range_data$attribute_short <- unname(short_attribute[range_data$attribute])
range_data$attribute_short <- factor(
  range_data$attribute_short,
  levels = range_data$attribute_short
)
range_data$is_crime <- range_data$attribute == crime_attribute

endpoints <- rbind(
  data.frame(
    attribute_short = range_data$attribute_short,
    value = range_data$min_mm, conf.low = range_data$min_low,
    conf.high = range_data$min_high, is_crime = range_data$is_crime
  ),
  data.frame(
    attribute_short = range_data$attribute_short,
    value = range_data$max_mm, conf.low = range_data$max_low,
    conf.high = range_data$max_high, is_crime = range_data$is_crime
  )
)

figure <- ggplot(range_data, aes(y = attribute_short)) +
  geom_vline(xintercept = 0.5, linetype = "dashed", colour = "#8C8C8C") +
  geom_segment(
    aes(x = min_mm, xend = max_mm, yend = attribute_short),
    colour = "#777777", linewidth = 1
  ) +
  geom_segment(
    data = range_data[range_data$is_crime, ],
    aes(x = min_mm, xend = max_mm, yend = attribute_short),
    colour = "#0072B2", linewidth = 1.4
  ) +
  geom_errorbar(
    data = endpoints,
    aes(x = value, xmin = conf.low, xmax = conf.high),
    orientation = "y", width = 0.12, colour = "#333333", linewidth = 0.55
  ) +
  geom_point(
    data = endpoints,
    aes(x = value, shape = is_crime, fill = is_crime),
    size = 3.2, colour = "#222222", stroke = 0.4
  ) +
  scale_shape_manual(values = c(`FALSE` = 21, `TRUE` = 24), guide = "none") +
  scale_fill_manual(values = c(`FALSE` = "#FFFFFF", `TRUE` = "#0072B2"), guide = "none") +
  scale_x_continuous(
    name = "Marginal mean of profile selection (IRR-corrected probability)",
    limits = c(0.30, 0.70), breaks = seq(0.30, 0.70, 0.10)
  ) +
  scale_y_discrete(name = NULL) +
  theme_minimal(base_size = 11) +
  theme(
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank(),
    axis.text.y = element_text(colour = "#222222"),
    axis.title.x = element_text(margin = margin(t = 8)),
    plot.margin = margin(8, 18, 8, 8)
  )

ggsave(
  filename = file.path(out_dir, "sensitivity.png"),
  plot = figure, width = 8, height = 5, units = "in", dpi = 320,
  bg = "white"
)

# --- Markdown sensitivity table -------------------------------------------

markdown_table <- function(d) {
  header <- paste0("| ", paste(names(d), collapse = " | "), " |")
  rule <- paste0("|", paste(rep("---", ncol(d)), collapse = "|"), "|")
  body <- apply(d, 1, function(row) paste0("| ", paste(row, collapse = " | "), " |"))
  c(header, rule, body)
}

mm_display <- data.frame(
  Attribute = mm$attribute,
  Level = mm$level,
  `Marginal mean [95% CI]` = sprintf(
    "%.3f [%.3f, %.3f]", mm$estimate, mm$conf.low, mm$conf.high
  ),
  check.names = FALSE, stringsAsFactors = FALSE
)

table_text <- c(
  "# Reference-category sensitivity and marginal means",
  "",
  paste0(
    "All entries are IRR-corrected profile-level estimates from `projoint`; ",
    "95% confidence intervals are in brackets. The repeated task estimates tau = ",
    sprintf("%.3f", mm_fit$tau), ". Marginal means are baseline-invariant."
  ),
  "",
  "## Violent Crime Rate AMCEs under each baseline",
  "",
  "Each non-reference cell is the AMCE for the row level relative to the column's reference level.",
  "",
  markdown_table(crime_rebaseline),
  "",
  "The crime attribute is binary, so changing the reference merely reverses the sign of the one pairwise contrast; its absolute magnitude is unchanged.",
  "",
  "## Multi-level check: Housing Cost AMCEs under each baseline",
  "",
  "With three levels, the numerical AMCE attached to a level changes with the selected reference, although every pairwise contrast is the same comparison regardless of coding.",
  "",
  markdown_table(housing_rebaseline),
  "",
  "## Marginal means for all levels",
  "",
  markdown_table(mm_display),
  "",
  "Figure caption: Endpoint marginal means (with 95% confidence intervals) for each attribute. Lines span the minimum and maximum observed marginal mean within each attribute; blue triangles identify the two crime-rate levels. The figure uses 400 respondents and 8 paired tasks per respondent (plus one flipped repeat); MMs are IRR-corrected profile-selection probabilities."
)

writeLines(table_text, "sensitivity-table.md", useBytes = TRUE)

message("Estimated IRR tau: ", sprintf("%.3f", mm_fit$tau))
message("Wrote figures/sensitivity.png and sensitivity-table.md")

=== QUESTION ===
This is a completed submission against the brief above. What would you change?
