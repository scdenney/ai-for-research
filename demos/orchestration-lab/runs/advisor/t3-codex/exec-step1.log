        attlev_notchoose <- stringr::str_c(.att_notchoose, ":", 
            .lev_notchoose)
        keep_task_constant_cols <- function(df, id_cols) {
            if (!all(c("id", "task", "profile") %in% names(df))) {
                return(id_cols)
            }
            core <- intersect(c("id", "task", "agree"), id_cols)
            cand <- setdiff(id_cols, core)
            if (length(cand) == 0L) {
                return(core)
            }
            max_ndist <- unlist(dplyr::summarise(dplyr::summarise(dplyr::group_by(df, 
                id, task), dplyr::across(dplyr::all_of(cand), 
                ~dplyr::n_distinct(.x, na.rm = FALSE)), .groups = "drop"), 
                dplyr::across(dplyr::everything(), ~max(.x, na.rm = TRUE))), 
                use.names = TRUE)
            safe <- names(max_ndist)[max_ndist <= 1]
            unique(c(core, safe))
        }
        if (.att_choose == .att_notchoose) {
            out1 <- dplyr::select(dplyr::mutate(.dataframe, qoi = !!rlang::sym(.att_choose)), 
                -matches("^att\\d+$"))
            id_cols <- setdiff(names(out1), c("profile", "selected", 
                "selected_repeated", "qoi"))
            id_cols <- keep_task_constant_cols(out1, id_cols)
            out2 <- tidyr::pivot_wider(out1, id_cols = dplyr::all_of(id_cols), 
                names_from = profile, values_from = c(selected, 
                  qoi))
            stopifnot(all(dplyr::pull(dplyr::count(out2, id, 
                task), n) == 1L))
            out3 <- dplyr::filter(out2, (qoi_1 %in% attlev_choose & 
                qoi_2 %in% attlev_notchoose) | (qoi_1 %in% attlev_notchoose & 
                qoi_2 %in% attlev_choose))
        }
        else {
            out1 <- dplyr::select(dplyr::mutate(.dataframe, qoi_choose = !!rlang::sym(.att_choose), 
                qoi_notchoose = !!rlang::sym(.att_notchoose)), 
                -matches("^att\\d+$"))
            id_cols <- setdiff(names(out1), c("profile", "selected", 
                "selected_repeated", "qoi_choose", "qoi_notchoose"))
            id_cols <- keep_task_constant_cols(out1, id_cols)
            out2 <- tidyr::pivot_wider(out1, id_cols = dplyr::all_of(id_cols), 
                names_from = profile, values_from = c(selected, 
                  qoi_choose, qoi_notchoose))
            stopifnot(all(dplyr::pull(dplyr::count(out2, id, 
                task), n) == 1L))
            out3 <- dplyr::filter(out2, (qoi_choose_1 %in% attlev_choose & 
                qoi_notchoose_2 %in% attlev_notchoose) | (qoi_choose_2 %in% 
                attlev_choose & qoi_notchoose_1 %in% attlev_notchoose))
        }
        out <- out3
    }
    data1 <- tibble::as_tibble(dplyr::select(dplyr::ungroup(dplyr::slice(dplyr::group_by(dplyr::filter(.dataframe, 
        !is.na(agree)), id), 1)), -matches("^att\\d+$")))
    data2 <- out
    return(list(data_for_irr = data1, data_for_estimand = data2))
}
