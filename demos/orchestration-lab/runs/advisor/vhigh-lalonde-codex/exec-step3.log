+  gse <- if (nt == nrow(nsw_t)) gap_hc(a) else NA_real_
+  c(estimate=est, se=fixed_hc(a), gap=gap, gap_se=gse, n_treated=nt,
+    n_controls=sum(a$treat == 0), ess_control=1/sum(wc^2), max_smd=max_smd(a,cv))
+}
