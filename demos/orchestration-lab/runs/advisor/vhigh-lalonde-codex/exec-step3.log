+wvar <- function(x,w) sum(w * (x - weighted.mean(x,w))^2) / sum(w)
+max_smd <- function(a, cv) {
+  tr <- a$treat == 1; wc <- abs(a$w[!tr]); wc <- wc / sum(wc)
+  smd <- vapply(cv, function(v) {
+    mt <- mean(a[[v]][tr]); mc <- weighted.mean(a[[v]][!tr], wc)
